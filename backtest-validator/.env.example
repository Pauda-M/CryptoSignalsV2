# btval's OWN database password (btval-db container). Not a TradeNet credential.
BTVAL_DB_PASSWORD=change-me
# pbFinance (simulator) base url. Must be an allowlisted internal host.
BTVAL_SIM_URL=http://binance-simulator:8976
BTVAL_SIM_HOSTS=binance-simulator,pbfinance
# Simulator API key/secret ONLY. Never a real Binance key.
BTVAL_SIM_API_KEY=
BTVAL_SIM_API_SECRET=
# Docker network on which pbFinance is reachable.
SIM_NETWORK=pb-tradenet-v2
