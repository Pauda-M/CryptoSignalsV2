{
  "name": "crypto-trader-v2",
  "version": "2.0.0",
  "description": "Modular cryptocurrency trading platform with ML-powered signals - Portable Cross-Platform",
  "main": "index.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "install-all": "npm install && npm install --workspaces",
    "dev": "node ops/scripts/dev-runner.js",
    "start": "node ops/scripts/prod-runner.js",
    "build": "npm run build --workspaces",
    "docker:build": "docker-compose -f ops/docker/docker-compose.yml build",
    "docker:up": "docker-compose -f ops/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f ops/docker/docker-compose.yml down",
    "init": "node ops/scripts/init.js",
    "db:init": "node db/postgres/init.js",
    "db:migrate": "node db/postgres/migrate.js",
    "db:seed": "node db/postgres/seed.js"
  },
  "dependencies": {
    "pg": "^8.11.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
