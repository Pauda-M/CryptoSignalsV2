:root {
  --bg: #020617;
  --bg-elevated: #020617;
  --bg-card: #020617;
  --border-subtle: rgba(148, 163, 184, 0.25);
  --accent: #8b5cf6;
  --accent-soft: rgba(139, 92, 246, 0.12);
  --accent-strong: #a855f7;
  --text-main: #e5e7eb;
  --text-muted: #9ca3af;
  --danger: #f97373;
  --success: #22c55e;
  --warning: #eab308;
}

/* Global layout ----------------------------------------------------------- */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body,
#root {
  height: 100%;
}

body {
  margin: 0;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
    sans-serif;
  background:
    radial-gradient(circle at 0 0, rgba(148, 163, 184, 0.24), transparent 50%),
    radial-gradient(circle at 100% 0, rgba(56, 189, 248, 0.18), transparent 55%),
    radial-gradient(circle at 50% 100%, rgba(88, 28, 135, 0.35), transparent 60%),
    var(--bg);
  color: var(--text-main);
}

/* App shell --------------------------------------------------------------- */

.app {
  min-height: 100vh;
  max-width: 1440px;
  margin: 0 auto;
  padding: 32px 32px 48px;
}

.app-header {
  margin-bottom: 24px;
}

.app-title {
  font-size: 28px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #f9fafb;
  text-shadow: 0 0 30px rgba(148, 163, 184, 0.65);
}

.app-subtitle {
  margin-top: 6px;
  font-size: 14px;
  color: var(--text-muted);
}

/* Top nav tabs ------------------------------------------------------------ */

.tab-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  padding: 4px;
  margin: 20px 0 28px;
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.88);
  border: 1px solid rgba(148, 163, 184, 0.35);
  box-shadow:
    0 0 0 1px rgba(15, 23, 42, 0.9),
    0 18px 40px rgba(15, 23, 42, 0.85);
}

.tab-button {
  position: relative;
  border: none;
  outline: none;
  cursor: pointer;
  padding: 8px 18px;
  border-radius: 999px;
  font-size: 13px;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  font-weight: 500;
  color: var(--text-muted);
  background: transparent;
  transition:
    color 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease,
    transform 0.12s ease;
}

.tab-button:hover {
  color: #e5e7eb;
  background: rgba(30, 64, 175, 0.14);
}

.tab-button.active {
  color: #f9fafb;
  background: radial-gradient(circle at 0 0, #38bdf8, #4f46e5 48%, #a855f7 100%);
  box-shadow:
    0 0 0 1px rgba(15, 23, 42, 0.9),
    0 10px 28px rgba(88, 28, 135, 0.7);
  transform: translateY(-1px);
}

/* Content area ------------------------------------------------------------ */

.app-content {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

/* Cards ------------------------------------------------------------------- */

.card {
  background: radial-gradient(circle at 0 0, rgba(148, 163, 184, 0.08), transparent 45%),
    rgba(15, 23, 42, 0.98);
  border-radius: 18px;
  padding: 18px 20px 16px;
  border: 1px solid var(--border-subtle);
  box-shadow:
    0 0 0 1px rgba(15, 23, 42, 1),
    0 16px 40px rgba(15, 23, 42, 0.9);
  backdrop-filter: blur(16px);
}

.card-header {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 10px;
}

.card-title {
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #e5e7eb;
}

.card-subtitle {
  font-size: 12px;
  color: var(--text-muted);
}

/* Filters / controls ------------------------------------------------------ */

.filters-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 18px;
  align-items: center;
  font-size: 12px;
  color: var(--text-muted);
}

.filters-panel label {
  display: flex;
  align-items: center;
  gap: 6px;
}

.filters-panel input,
.filters-panel select {
  background: rgba(15, 23, 42, 0.9);
  border-radius: 8px;
  border: 1px solid var(--border-subtle);
  padding: 5px 8px;
  color: var(--text-main);
  font-size: 12px;
}

.filters-panel input:focus,
.filters-panel select:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 1px rgba(129, 140, 248, 0.7);
}

/* Tables ------------------------------------------------------------------ */

.table-wrapper {
  width: 100%;
  overflow-x: auto;
  border-radius: 12px;
  border: 1px solid var(--border-subtle);
  background: rgba(15, 23, 42, 0.96);
}

.table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

.table thead {
  background: linear-gradient(to right, rgba(15, 23, 42, 0.95), rgba(30, 64, 175, 0.35));
}

.table th,
.table td {
  padding: 8px 10px;
  white-space: nowrap;
  text-align: right;
}

.table th:first-child,
.table td:first-child {
  text-align: left;
}

.table th {
  font-weight: 500;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  font-size: 11px;
  color: #9ca3af;
  border-bottom: 1px solid rgba(148, 163, 184, 0.45);
}

.table tbody tr {
  border-bottom: 1px solid rgba(31, 41, 55, 0.7);
}

.table tbody tr:hover {
  background: rgba(30, 64, 175, 0.35);
}

/* Status pills & badges --------------------------------------------------- */

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 46px;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 500;
}

.pill-green {
  background: rgba(22, 163, 74, 0.18);
  color: #4ade80;
}

.pill-red {
  background: rgba(220, 38, 38, 0.18);
  color: #fca5a5;
}

.pill-amber {
  background: rgba(245, 158, 11, 0.2);
  color: #facc15;
}

/* Misc helpers ------------------------------------------------------------ */

.text-muted {
  color: var(--text-muted);
}

.text-accent {
  color: var(--accent-strong);
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 8px;
  border-radius: 999px;
  font-size: 11px;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid var(--border-subtle);
}
